# ------------ Cron schedules ------------
# هر روز ساعت ۲۱ چک میشه کدوم دانش‌آموزها گزارش کار امروزشون رو نفرستادن
DAILY_REPORT_CHECK_CRON=*/30 * * * *
# هر روز ساعت ۰۰:۱۰ برای ماه شمسی جاری رکورد شهریه (unpaid) برای دانش‌آموزهایی که ندارن ساخته میشه
TUITION_PAYMENT_CRON=10 0 * * *
# هر ساعت چک میشه آزمون‌هایی که تاریخ برگزاریشون گذشته و فردای برگزاریشون هم گذشته ولی دانش‌آموز فرم تحلیل نفرستاده
ANALYSIS_EXAM_CHECK_CRON=*/30 * * * *

